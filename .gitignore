# Environment and local data
.env
.env.*
!.env.example
venv/
# chroma_db/ is shared via Git LFS (see .gitattributes)
*.sqlite3
!chroma_db/chroma.sqlite3

# source_data: keep local PDFs out of git (OCR cache is LFS-tracked instead)
source_data/*
!source_data/README.md

# Generated / local OCR scratch (final cache is LFS-tracked)
full_text_ocr.partial.txt
full_text_ocr.progress.json
full_text_ocr_cleaned.txt

# Python cache
__pycache__/
*.pyc

# Logs and OS
ingest_ocr.log
load_status.json
load_to_db_ollama.log
.DS_Store
